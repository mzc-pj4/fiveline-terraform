<mxfile host="app.diagrams.net">
  <diagram name="이커머스 WAF Rate Limit" id="ecommerce-waf-ratelimit">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== TITLE ===== -->
        <mxCell id="title" value="이커머스 특화 WAF Rate Limit — 3가지 공격 시나리오 차단" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="15" width="1500" height="38" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="관리형 룰셋으로 탐지 불가한 &apos;정상 형식의 이커머스 특화 공격&apos;을 CloudFront WAF 엔드포인트별 Rate Limit으로 차단" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="50" y="52" width="1500" height="22" as="geometry" />
        </mxCell>

        <!-- ===== CloudFront WAF CONTAINER ===== -->
        <mxCell id="waf-container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7600;strokeWidth=2.5;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="370" y="80" width="700" height="565" as="geometry" />
        </mxCell>
        <mxCell id="waf-icon" value="" style="shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.waf;html=1;labelBackgroundColor=none;sketch=0;fillColor=#2d7600;strokeColor=#1a4700;" vertex="1" parent="1">
          <mxGeometry x="687" y="88" width="56" height="56" as="geometry" />
        </mxCell>
        <mxCell id="waf-title" value="CloudFront WAF" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#2d7600;" vertex="1" parent="1">
          <mxGeometry x="370" y="148" width="700" height="26" as="geometry" />
        </mxCell>
        <mxCell id="waf-note-top" value="실제 클라이언트 IP 기준 Rate Limit (aggregate_key_type = &quot;IP&quot;) — Regional WAF 배치 시 CloudFront Edge IP만 보여 개별 공격자 차단 불가" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#2d7600;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="370" y="174" width="700" height="20" as="geometry" />
        </mxCell>

        <!-- RULE 1: ecommerce-login-ratelimit -->
        <mxCell id="rule1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="395" y="205" width="650" height="105" as="geometry" />
        </mxCell>
        <mxCell id="rule1-name" value="ecommerce-login-ratelimit  [Priority 0]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="410" y="211" width="430" height="26" as="geometry" />
        </mxCell>
        <mxCell id="rule1-detail" value="URI: /api/auth/login&lt;br&gt;동일 IP → &lt;b&gt;100 req / 5min 초과 시 BLOCK 429&lt;/b&gt;&lt;br&gt;방어: 크리덴셜 스터핑 (유출 ID/PW 자동 대입 차단)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="410" y="240" width="630" height="64" as="geometry" />
        </mxCell>

        <!-- RULE 2: ecommerce-orders-ratelimit -->
        <mxCell id="rule2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="395" y="325" width="650" height="105" as="geometry" />
        </mxCell>
        <mxCell id="rule2-name" value="ecommerce-orders-ratelimit  [Priority 1]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="410" y="331" width="430" height="26" as="geometry" />
        </mxCell>
        <mxCell id="rule2-detail" value="URI: /api/orders&lt;br&gt;동일 IP → &lt;b&gt;100 req / 5min 초과 시 BLOCK 429&lt;/b&gt;&lt;br&gt;방어: 카드 BIN 어택 (훔친 카드번호 결제 엔드포인트 대량 검증 차단)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="410" y="360" width="630" height="64" as="geometry" />
        </mxCell>

        <!-- RULE 3: ecommerce-products-ratelimit -->
        <mxCell id="rule3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6d4bb4;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="395" y="445" width="650" height="105" as="geometry" />
        </mxCell>
        <mxCell id="rule3-name" value="ecommerce-products-ratelimit  [Priority 2]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#6d4bb4;" vertex="1" parent="1">
          <mxGeometry x="410" y="451" width="430" height="26" as="geometry" />
        </mxCell>
        <mxCell id="rule3-detail" value="URI: /api/products&lt;br&gt;동일 IP → &lt;b&gt;500 req / 5min 초과 시 BLOCK 429&lt;/b&gt;&lt;br&gt;방어: 가격 스크래핑 (임계값 완화 — 정상 조회가 많은 엔드포인트)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#6d4bb4;" vertex="1" parent="1">
          <mxGeometry x="410" y="480" width="630" height="64" as="geometry" />
        </mxCell>

        <!-- WAF bottom note -->
        <mxCell id="waf-bottom-note" value="* 5min = 롤링 카운팅 윈도우 (차단 지속 시간 아님) — 임계값 아래로 내려오면 자동 해제" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="370" y="570" width="700" height="20" as="geometry" />
        </mxCell>

