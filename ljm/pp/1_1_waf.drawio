        <mxCell id="a-rules" value="/api/auth/login  →  100 req / 5min  (크리덴셜 스터핑)&lt;br&gt;/api/orders      →  100 req / 5min  (카드 BIN 어택)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7600;fontSize=12;fontColor=#2d7600;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1">
