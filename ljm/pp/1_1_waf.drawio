<mxfile host="app.diagrams.net">
  <diagram name="슬라이드1 — 의문과 조사" id="pg1">
    <mxGraphModel dx="1422" dy="762" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s1-title" value="AWS 관리형 룰셋의 한계" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="36" width="1400" height="46" as="geometry" />
        </mxCell>
        <mxCell id="s1-sub" value="관리형 룰셋은 &lt;b&gt;공격 패턴&lt;/b&gt;을 기준으로 탐지한다 — HTTP 형식이 정상인 요청은 탐지할 수 없다" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="100" y="80" width="1400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="s1-lh" value="✅  관리형 룰셋 탐지 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d7600;fontSize=15;fontStyle=1;fontColor=#2d7600;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="122" width="580" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s1-rh" value="❌  관리형 룰셋 탐지 불가" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;fontStyle=1;fontColor=#b85450;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="122" width="580" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s1-vs" value="VS" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#111111;fontSize=15;fontStyle=1;fontColor=#ffffff;align=center;" vertex="1" parent="1">
          <mxGeometry x="756" y="126" width="88" height="42" as="geometry" />
        </mxCell>
        <mxCell id="s1-l1" value="&lt;b&gt;SQL 인젝션 / XSS / Command Injection&lt;/b&gt;&lt;br&gt;요청 본문에 악성 패턴 포함 — 패턴으로 식별 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff0;strokeColor=#2d7600;fontSize=13;fontColor=#333333;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s1-l2" value="&lt;b&gt;Log4Shell / SSRF / Spring4Shell&lt;/b&gt;&lt;br&gt;알려진 취약점 익스플로잇 패턴 — 시그니처로 식별 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff0;strokeColor=#2d7600;fontSize=13;fontColor=#333333;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="298" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s1-l3" value="&lt;b&gt;봇넷 / C&amp;C 서버 / Tor 출구 노드&lt;/b&gt;&lt;br&gt;AWS가 관리하는 알려진 악성 IP 목록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff0;strokeColor=#2d7600;fontSize=13;fontColor=#333333;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="396" width="580" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s1-r1" value="&lt;b&gt;크리덴셜 스터핑&lt;/b&gt;&lt;br&gt;POST /api/auth/login — 완전히 정상적인 로그인 요청&lt;br&gt;유출된 ID/PW 자동 대입 → 계정 탈취" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#b85450;fontSize=13;fontColor=#333333;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="230" width="580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s1-r2" value="&lt;b&gt;카드 BIN 어택&lt;/b&gt;&lt;br&gt;POST /api/orders — 완전히 정상적인 결제 요청&lt;br&gt;훔친 카드번호 대량 검증 → 결제사 제재" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0f0;strokeColor=#b85450;fontSize=13;fontColor=#333333;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="348" width="580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s1-div" value="" style="line;strokeColor=#aaaaaa;strokeWidth=1.5;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="80" y="472" width="1440" height="10" as="geometry" />
        </mxCell>
        <mxCell id="s1-insight" value="공통 특징: HTTP 형식 완전히 정상 → 패턴 매칭으로 탐지 불가 → &lt;b&gt;빈도(횟수)로만 구분 가능&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontColor=#333333;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="492" width="1400" height="58" as="geometry" />
        </mxCell>
        <mxCell id="s1-cta" value="→  이커머스 서비스 구조를 이해한 &lt;b&gt;엔드포인트별 커스텀 Rate Limit&lt;/b&gt; 이 필요하다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;fontStyle=1;fontColor=#23445d;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="566" width="1400" height="58" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
